# A systemd *user* unit: it runs as the account that owns the store, needs no
# root, and starts at boot once lingering is enabled for that account.
#
# Install and enable:
#
#   install -Dm644 deploy/mustur.service ~/.config/systemd/user/mustur.service
#   loginctl enable-linger "$USER"          # so it starts without a login
#   systemctl --user daemon-reload
#   systemctl --user enable --now mustur
#
# **Never enable this on a host whose hostname is not already behind Cloudflare
# Access.** The tunnel routes mustur.devofpie.com to 127.0.0.1:7777, so starting
# this publishes every surface on that port.
#
# Since milestone 4b that need not be only the intake box. The session surface
# can go on the same mux, and where it does an unprotected hostname is **a
# writable channel into a running agent's stdin** — not somebody filing a jot
# under the wrong name. The WebSocket refuses a cross-origin handshake, which
# stops a page the owner visited from opening one; it does nothing about
# somebody who simply reaches the hostname. Access is what does that, and
# MUS-Q-0018 is explicit that Access and the origin check are the whole of the
# defence.
#
# **This unit serves it, since 2026-08-23.** `serve` needs `--sessions` and this
# ExecStart passes it. It did not until the owner confirmed the Access policy
# admits only their identity, because publishing a path into a running agent is
# a decision to take on its own and not a side effect of deploying whatever else
# shipped in the same binary (MUS-D-0095). Remove the flag and the surface is
# gone again, along with the tab the other surfaces offer to it — which is the
# knob to reach for if the policy ever widens.
#
# On mustur.devofpie.com the gate went up before anything listened and the unit
# is enabled; the rule is stated for the next host. docs/ingress.md carries the
# order and the reason.
#
# **`--origin` since 2026-08-25, and deliberately without `--accounts`.** The
# origin publishes the sign-in and invitation surfaces and enforces nothing: a
# passkey is bound to the origin it was registered on, so somebody has to be
# able to register one before the guard can be turned on without locking the
# owner out of their own service. It must be the public origin exactly — the
# hostname a browser sees — because the relying-party id derives from it and a
# passkey registered under the wrong one is a passkey this server can never ask
# for again.
#
# **`--accounts` since 2026-08-26**, and the order it was reached in matters:
# origin first, then the first owner made on this machine, then a passkey
# registered from a device and *seen to sign in*, then an agent token, then
# this. Any other order locks the owner out, or cuts every agent off from the
# mandated tool call — an MCP client carries no session cookie, so without a
# token `/mcp` answers 403 to all of them (MUS-M-0012).
#
# The passkey step is not a formality. The first one registered here could never
# have signed in: MUS-F-0029, backup flags that were never stored, which made
# every synced credential manager's passkey register cleanly and fail forever.
# Enforcing on top of that would have locked the owner out of their own service
# with no way back except this file.
#
# Cloudflare Access stays in front throughout and comes off on the owner's
# judgement (MUS-Q-0039), not as a side effect of this flag.
#
# **`--placeholders 10` is temporary and is meant to come out.** It pads the
# intake destination list with ten choices that are not real, so the owner can
# judge whether a list that size wants searching before there is anything to
# search. They are never stored, refuse to be filed to, and vanish with the
# flag. If this is still here once the question is answered, that is the defect.
#
# **Stopping this unit hangs while a session is being piped** (MUS-F-0030): the
# pipe reader blocks uninterruptibly, systemd's stop times out at 90s, and the
# unreaped process holds the port the whole time. Turn the pipe off first —
# `tmux pipe-pane -t <pane>` — and the stop is immediate.

[Unit]
Description=Mustur — records, routing and intake
Documentation=https://github.com/DevOfPie/Mustur
# Not a hard dependency on the tunnel: the two are separately owned, the tunnel
# is a system unit and this is a user one, and a Mustur that cannot be reached
# is still a Mustur worth having running.
After=network-online.target

[Service]
Type=simple
# Loopback only. The tunnel is what publishes it, and `serve` refuses any
# address that is not loopback for that reason.
ExecStart=%h/.local/bin/mustur serve --addr 127.0.0.1:7777 --export %h/repos/DevOfPie/Mustur/records --sessions --origin https://mustur.devofpie.com --accounts --placeholders 10
# Not on-failure: systemd counts a SIGTERM as a clean exit, so on-failure left a
# TERMed process dead with no restart scheduled and nothing watching. Access
# answers 302 whether or not the origin is up, so the hostname check in
# docs/ingress.md cannot tell a live box from a dead one. `systemctl --user
# stop` still stops it — always restarts on exit, not against a deliberate stop.
Restart=always
RestartSec=5s

# The store is the record and lives outside the checkout.
Environment=MUSTUR_DB=%h/.local/share/mustur/mustur.db
# Records written through the surface are the owner's, not "unknown".
Environment=MUSTUR_ACTOR=whippy

# It reads a catalog, writes a store and one export tree, and talks to tmux.
NoNewPrivileges=yes
# NOT PrivateTmp. tmux's socket is /tmp/tmux-$UID, so a private /tmp cannot
# reach the owner's tmux server at all — and a review caught that leaving the
# answer path inert exactly where it ships: every answer filed from the phone
# would have recorded "not delivered" while the code looked correct. Carrying an
# answer back into a session is what this unit is for, and a hardening flag that
# silently removes the feature is worse than the hardening is worth.
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mustur %h/repos/DevOfPie/Mustur/records

[Install]
WantedBy=default.target
